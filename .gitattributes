# Keep the repository's text files byte-identical in every working tree.
#
# The authors build the paper from several checkouts of this repository on
# different machines, and the LaTeX sources must compare equal across them.
# Declaring LF here removes the platform default (core.autocrlf) from the
# equation: a fresh clone on Windows produces the same bytes as one on Linux.
* text=auto eol=lf

# Binary assets: never convert, never diff.
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.zip  binary
*.pt   binary
*.pth  binary
*.npz  binary
*.npy  binary
*.pkl  binary
