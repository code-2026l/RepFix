repository-code: "https://github.com/code-2026l/RepFix"
license-url: "https://github.com/code-2026l/RepFix/blob/main/LICENSE"
keywords:
  - multi-task learning
  - gradient conflict
  - representation collapse
  - saddle-node bifurcation
  - capacity law
  - auxiliary task
preferred-citation:
